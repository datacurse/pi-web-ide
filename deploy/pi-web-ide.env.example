# pi-web-ide service environment.
#
# deploy/install.sh copies this to ~/.config/pi-web-ide/env with the
# home-directory placeholder expanded, and never overwrites an existing file —
# so edit the installed copy, not this one.
#
# systemd expands neither shell variables nor unit specifiers inside an
# EnvironmentFile, so every path below must be absolute. Hence the placeholder:
# install.sh is the only thing in this pipeline that knows your home directory.
#
# After editing:  systemctl --user restart pi-web-ide

# One piw per machine, serving its own browser. Reach another machine's piw by
# forwarding its port yourself (`ssh -L 8890:localhost:8890 thatbox`) or with
# `tailscale serve`; give each a distinct port when you forward several to the
# same laptop.
PIW_PORT=8890

# The workspace piw starts on. It seeds the project list; further projects are
# added from the UI. Not optional — left unset, index.ts falls back to the
# process cwd, which under systemd is the checkout itself.
PIW_CWD=@HOME@

# Startup model as "provider/id". Unset means pi's own configured default,
# which may select a provider your plan blocks. The list comes from pi over
# RPC and is shown in the settings dialog.
# PIW_MODEL=anthropic/claude-haiku-4-5

# Path to the pi binary. Unset resolves `pi` on PATH; the unit runs through a
# login shell so ~/.local/bin is normally present, but set this if you would
# rather the service not depend on your shell profile.
# PIW_PI_BIN=@HOME@/.local/bin/pi

# Where this server keeps its own state — the project list, the pinned folders
# and the personality text. Unset means ~/.config/pi-web-ide.
# PIW_STATE_DIR=@HOME@/.config/pi-web-ide

# Model used for the one-shot children that write commit messages and session
# names. Unset means pi's default, which is never wrong — just slower and
# dearer than a small model for a one-sentence chore.
# PIW_NAMING_MODEL=anthropic/claude-haiku-4-5

# How long one `pi install|remove|update` may take before it is killed. A
# cold git clone plus `npm install` on a Pi is the case this is sized for.
# PIW_PACKAGES_TIMEOUT_MS=300000

# How long an npm gallery search or package lookup is reused. Search results
# change when somebody publishes, not between two keystrokes.
# PIW_SEARCH_CACHE_MS=600000

# Startup kills an older piw holding PIW_PORT (identified by /api/health) and
# takes the port. Set to 0 under a supervisor if you ever run two units that
# could fight over one port; with a single unit, leaving it on means
# `systemctl --user restart pi-web-ide` cannot lose to a slow shutdown.
# PIW_TAKEOVER=1

# Test seam only: overrides the session root (~/.pi/agent/sessions) so tests
# can point at a fixture tree. Not for production use.
# PIW_SESSION_ROOT=

# Test seam only: overrides pi's settings file (~/.pi/agent/settings.json),
# which is where the default model and the installed package list live.
# PIW_PI_SETTINGS=
