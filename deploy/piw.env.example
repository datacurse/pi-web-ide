# piw service environment.
#
# deploy/install.sh copies this to ~/.config/piw/env with the home-directory
# placeholder expanded, and never overwrites an existing file — so edit the
# installed copy, not this one.
#
# systemd expands neither shell variables nor unit specifiers inside an
# EnvironmentFile, so every path below must be absolute. Hence the placeholder:
# install.sh is the only thing in this pipeline that knows your home directory.
#
# After editing:  systemctl --user restart piw

# Browser origins, comma-separated, allowed to drive this piw from ANOTHER
# machine's page: the piw whose Machines panel lists this one. Same-origin
# needs nothing, so a single-machine install can leave this unset — but on
# every machine that is listed from another one this is REQUIRED, and its
# absence shows over there as "up, but PIW_HUB_ORIGINS is not set on it".
#
# This is the CSRF boundary — an allowed origin can start an agent run here —
# so name the exact origins, never a wildcard. Through an ssh forward the
# other page is on its own loopback, e.g. http://127.0.0.1:8890; through
# tailscale serve it is that machine's https://name.tail.ts.net.
PIW_HUB_ORIGINS=http://127.0.0.1:8890

# One piw per machine. Give each machine a distinct port when you forward
# several to the same laptop; the Machines panel does that forwarding for you
# and picks the local port, so this is the port piw SERVES on, not a forward.
PIW_PORT=8890

# The workspace piw starts on. It seeds the project list; further projects are
# added from the UI. Not optional — left unset, index.ts falls back to the
# process cwd, which under systemd is the piw checkout itself.
PIW_CWD=@HOME@

# Startup model as "provider/id". Unset means omp's own configured default,
# which may select a provider your plan blocks. `omp models --json` lists them.
# PIW_MODEL=anthropic/claude-haiku-4-5

# Path to the omp binary. Unset resolves `omp` on PATH; the unit runs through a
# login shell so ~/.local/bin is normally present, but set this if you would
# rather the service not depend on your shell profile.
# PIW_OMP_BIN=@HOME@/.local/bin/omp

# Path to the ssh binary used for the Machines panel's tunnels. Same reasoning
# as PIW_OMP_BIN: unset resolves `ssh` on PATH.
# PIW_SSH_BIN=/usr/bin/ssh

# always-ask | write | yolo. Default yolo, because a browser client has no
# terminal to answer an approval prompt on: an approval-gated run would simply
# hang, which is indistinguishable from a wedged agent.
# PIW_APPROVAL_MODE=yolo

# Startup kills an older piw holding PIW_PORT (identified by /api/health) and
# takes the port. Set to 0 under a supervisor if you ever run two units that
# could fight over one port; with a single unit, leaving it on means
# `systemctl --user restart piw` cannot lose to a slow shutdown.
# PIW_TAKEOVER=1

# Test seam only: overrides the session root (~/.omp/agent/sessions) so tests
# can point at a fixture tree. Not for production use.
# PIW_SESSION_ROOT=

# The agent directory piw reads and writes PERSONALITY.md in. Unset means
# ~/.omp/agent, omp's own default; set it to match if you relocated omp's
# agent directory with PI_CODING_AGENT_DIR. Also the seam the personality test
# points at a temp dir.
# PIW_AGENT_DIR=@HOME@/.omp/agent
