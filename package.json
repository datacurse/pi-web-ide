{
	"name": "piw",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A deliberately thin web UI for the pi coding agent SDK",
	"scripts": {
		"dev": "concurrently -k -n server,web -c blue,green \"pnpm:dev:server\" \"pnpm:dev:web\"",
		"dev:server": "node --import tsx src/server/index.ts",
		"dev:server:watch": "node --watch --import tsx src/server/index.ts",
		"dev:web": "until nc -z 127.0.0.1 ${PIW_PORT:-8890}; do sleep 0.1; done && vite",
		"build": "vite build",
		"start": "node --import tsx src/server/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
		"@phosphor-icons/react": "^2.1.10",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"express": "4.21.2",
		"fancy-ansi": "^0.1.3",
		"katex": "^0.18.7",
		"markdown-to-jsx": "9.10.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.1.14",
		"@types/express": "4.17.21",
		"@types/node": "22.10.0",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "4.3.4",
		"concurrently": "9.1.0",
		"tailwindcss": "4.1.14",
		"tsx": "4.19.2",
		"typescript": "5.7.2",
		"vite": "6.0.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
