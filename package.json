{
	"name": "pwi",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A deliberately thin web UI for the pi coding agent",
	"scripts": {
		"dev": "pnpm build && node scripts/dev.mjs",
		"dev:server": "PWI_DEV=1 PWI_PORT=${PWI_PORT:-8890} PWI_TAKEOVER=${PWI_TAKEOVER:-0} node --watch --import tsx src/server/index.ts",
		"dev:web": "node scripts/dev.mjs wait && vite",
		"build": "vite build",
		"start": "node --import tsx src/server/index.ts",
		"typecheck": "tsc --noEmit && sh scripts/check-ui.sh && sh scripts/check-api.sh",
		"test": "node --test scripts/dev.test.mjs && timeout --kill-after=5s 30s node --import tsx --test --test-timeout=10000 src/**/*.test.ts",
		"deadcode": "knip --no-config-hints && knip --production --no-config-hints"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
		"@hono/node-server": "^2.1.1",
		"@lezer/highlight": "^1.2.3",
		"@phosphor-icons/react": "^2.1.10",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"fancy-ansi": "^0.1.3",
		"hono": "^4.13.9",
		"katex": "^0.18.7",
		"markdown-to-jsx": "9.10.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-virtuoso": "^4.18.16",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@shikijs/themes": "^4.4.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.10.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "4.3.4",
		"concurrently": "9.1.0",
		"knip": "6.39.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "5.7.2",
		"vite": "6.0.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
